---
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import NotFound from "@/components/pages/NotFound";
import type { Metadata } from "@/lib/metadata";
import { homeOgImage } from "@/lib/site-metadata";

const metadata: Metadata = {
  title: 'Page Not Found | LoanHero',
  description: 'The page you are looking for could not be found.',
  robots: 'noindex, follow',
};

// Same tags the old 404 had: an extra "noindex" robots tag and the home social image.
---

<BaseLayout metadata={metadata} extraRobots="noindex" fileOgImage={homeOgImage}>
  <NotFound />
</BaseLayout>
